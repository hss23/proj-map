{
  "name": "prospect-map-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Prospect Map Search API (Express + Joi + SQLite)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.22.3",
    "joi": "^17.13.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.4",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
